        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App wurde erfolgreich signiert, aber TreeNewBee konnte die folgenden Dateien nicht signieren. Möglicherweise können Sie die App verwenden, rechnen Sie jedoch mit Abstürzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App was signed successfully, but TreeNewBee was unable to sign the following files. You may be able to use the app, but do expect crash."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app se firmó correctamente, pero TreeNewBee no pudo firmar los siguientes archivos. Es posible que puedas usar la app, pero espera fallos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'application a été signée avec succès, mais TreeNewBee n'a pas pu signer les fichiers suivants. Vous pouvez utiliser l'application, mais attendez-vous à un crash."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app è stata registrata con successo, ma TreeNewBee non è stata in grado di registrare i seguenti file. Potresti essere in grado di usare l'app, ma aspettati dei crash."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリの署名に成功しましたが、TreeNewBeeは以下のファイルに署名できませんでした。アプリは使用できますが、クラッシュする可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 설치가 완료되었으나, 일부 파일 서명에 실패했습니다. 앱 사용 도중 앱이 충돌할 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Z powodzeniem, Aplikacja została podpisana. Jednak TreeNewBee nie był w stanie podpisać tych plików. Będziesz mieć możliwość używania aplikacji, ale oczekuj błędów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicativo foi assinado com sucesso, porém o TreeNewBee foi incapaz de assinar os seguintes arquivos. Você consegue utilizar o aplicativo, mas não possua expectativas de que não irá encerrar involuntariamente até certo ponto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение было успешно подписано, но TreeNewBee не смог подписать следующие файлы. Вы сможете воспользоваться приложением, но делайте это на свой страх и риск."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen signerades framgångsrikt, men TreeNewBee kunde inte signera följande filer. Du kanske kan använda appen, men förvänta dig krasch."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama başarıyla imzalandı, ancak TreeNewBee aşağıdaki dosyaları imzalayamadı. Uygulamayı kullanabilirsiniz, ancak çökme olasılığı vardır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "App đã được ký, nhưng TreeNewBee không ký được các file sau đây. Bạn có thể dùng app, nhưng nó có thể văng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App签名成功，但以下文件签名失败。App有可能可以正常运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "應用程式已成功簽名，但🌲树应用無法簽署以下檔案。 您可能能夠使用該應用程式，但可能會崩潰。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปลงนาม d สำเร็จ fully แต่ TreeNewBee ไม่ใช่ able เพื่อลงนาม following files คุณอาจเป็น able เพื่อใช้แอป แต่ do คาดว่าจะเกิดข้อผิดพลาด"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apl telah berjaya ditandatanganidfully, tetapi TreeNewBee telah menyahle untuk menandatangani following files. Anda mungkin able untuk menggunakan apl itu, tetapi do menjangkakan ranap sistem."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi ditandatanganied suksesfully, tetapi TreeNewBee tidakable untuk menandatangani following files. Anda mungkin able untuk menggunakan aplikasi ini, tetapi do mengharapkan crash."
          }
        }
      }
    },
