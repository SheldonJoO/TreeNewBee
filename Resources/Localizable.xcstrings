    "lc.settings.multiLCLaunchPriorityDesc": {
      "comment": "Drag LiveContainers to choose which one is tried first when launching shared apps.",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب TreeNewBee لاختيار أي واحد يتم تجربته أولا عند تشغيل التطبيقات المشتركة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen Sie die TreeNewBee, um festzulegen, welche App zuerst gestartet wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag TreeNewBee to choose which one is tried first when launching shared apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra los Live Containers para elegir cuál se intenta primero al lanzar apps compartidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser les TreeNewBee pour choisir lequel est essayé en premier lors du lancement d'applications partagées."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij TreeNewBee, aby wybrać, który z nich zostanie wypróbowany jako pierwszy podczas uruchamiania udostępnionych aplikacji."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетаскивайте TreeNewBee'ы, чтобы выбрать, какой из них будет использован при запуске общих приложений."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
