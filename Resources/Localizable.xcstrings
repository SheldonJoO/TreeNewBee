    "lc.settings.importCertificateDesc": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لأستعمال وضع بدون-JIT دون AltStore/openSSS، عليك أستيراد الشهادة الذي تم توقيع TreeNewBee بها، هل تود المتابعة؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie den JITLess-Modus ohne AltStore/openSSS nutzen möchten, müssen Sie das Zertifikat importieren, mit dem TreeNewBee signiert wurde. Fortfahren?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To use JITLess mode without AltStore/openSSS, you have to import the certificate used to sign TreeNewBee. Continue?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para usar el modo JITLess sin AltStore/openSSS, debes importar el certificado usado para firmar TreeNewBee. ¿Continuar?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour utiliser le mode sans JIT sans AltStore/openSSS, vous devez importer le certificat utilisé pour signer TreeNewBee. Poursuivre ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per utilizzare la modalità JITLess senza AltStore/openSSS, devi importare il certificato utilizzato per firmare TreeNewBee. Vuoi Continuare?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AltStore/openSSSなしでJITレスモードを使用するには、TreeNewBeeに署名するための証明書をインポートする必要があります。続けますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AltStore, openSSS 없이 JIT-Less 모드를 사용하려면, TreeNewBee를 설치할 때 사용한 동일한 인증서가 필요합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby używać trybu JIT-Less bez AltStore czy openSSS, trzeba zaimportować certyfikat użyty do podpisania TreeNewBee. Czy chcesz kontynuować?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para usar o modo JIT-Less sem a AltStore/openSSS, você deve importar, especificamente, o certificado usado para assinar o TreeNewBee. Deseja continuar?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы включить режим JIT-less без AltStore/openSSS, вам потребуется указать сертификат, которым вы подписали TreeNewBee. Продолжить?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För att använda JITLess utan AltStore/openSSS måste du importera certifikatet som används för att signera TreeNewBee. Vill du fortsätta?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AltStore/openSSS olmadan JITLess modunu kullanmak için, TreeNewBee'ı imzalamak için kullanılan sertifikayı içe aktarmanız gerekir. Devam etmek istiyor musunuz?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để dùng chức năng JITLess không cần AltStore/openSSS, bạn phải nhập chứng chỉ được dùng để ký TreeNewBee. Tiếp tục?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要不通过openSSS/AltStore使用免JIT模式，你需要导入用于签名🌲树应用的证书。要继续吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若不透過openSSS/AltStore使用免JIT模式，你需要匯入用於簽署🌲树应用的證書。要繼續嗎？"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากต้องการใช้ JITLess mode โดยไม่มี AltStore/openSSS คุณต้องนำเข้า certificate used เพื่อลงนาม TreeNewBee ดำเนินการต่อ?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk menggunakan JITless mode tanpa AltStore/openSSS, anda perlu mengimport certificate used untuk menandatangani TreeNewBee. teruskan?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk menggunakan JITLess mode tanpa AltStore/openSSS, Anda harus mengimpor certificate used untuk menandatangani TreeNewBee. Melanjutkan?"
          }
        }
      }
    },
