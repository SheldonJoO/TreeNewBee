    "lc.settings.signer.desc": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أذا أعطى AltSign خطأ، فحاول أن تستعمل Zsign و العكس صحيح. الرجاء اعادة تشغيل التطبيق TreeNewBee بعد تغيير الُموقع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn AltSign einen Fehler meldet, versuchen Sie es bitte mit ZSign und andersherum. Bitte starten Sie TreeNewBee nach dem Wechsel des Signierers neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If AltSign reports an error, please try ZSign and vice versa. Please restart TreeNewBee after switching Signer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si AltSign signale une erreur, essayez ZSign et vice versa. Veuillez redémarrer TreeNewBee après avoir changé de signataire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AltSign でエラーが発生する場合は、ZSign をお試しください。また、反対にZSignでエラーが発生する場合は、AltSignをお試しください。Signer を切り替えた後、 TreeNewBee を再起動してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se AltSign não funcionar corretamente, por favor tente mudar para ZSign e vice-versa. Por favor, reinicie TreeNewBee após alterar o método de assinar os aplicativos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om AltSign rapporterar ett fel, försök ZSign och vice versa. Starta om TreeNewBee efter byte av Signer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "若AltSign签名遇到问题，可尝试使用ZSign，反之亦然。切换签名工具后请重启🌲树应用。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "If AltSign รายงานข้อผิดพลาด please ลองใช้ ZSign and ในทางกลับกัน Please รีสตาร์ท TreeNewBee after การสลับผู้ลงนาม"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "If AltSign melaporkan ralat, please cuba ZSign and sebaliknya. Please mulakan semula Penandatangan pensuisan TreeNewBee after."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "If AltSign melaporkan kesalahan, please coba ZSign and dan sebaliknya. Please memulai ulang Penandatangan peralihan TreeNewBee after."
          }
        }
      }
    },
