    "lc.settings.multiLCInstallAlertDesc %@": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سوف يقوم TreeNewBee بتوليد ملف الـipa لـTreeNewBee أخر. الرجاء مشاركته إلى %@ للتثبيت، هل تود المتابعه؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TreeNewBee wird eine IPA für einen weiteren TreeNewBee generieren. Bitte teilen Sie diese mit %@, um sie zu installieren. Fortfahren?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TreeNewBee will generate the ipa for another TreeNewBee. Please share it to %@ to install it, Continue?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "TreeNewBee generará el ipa para otro TreeNewBee. Compártelo con %@ para instalarlo. ¿Continuar?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "TreeNewBee va générer l'IPA pour un autre TreeNewBee. Veuillez le partager à %@ pour l'installer. Continuer ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "TreeNewBee genererà l'ipa per un altro TreeNewBee. Condividilo su %@ per installarlo, Vuoi Continuare?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TreeNewBeeは別のTreeNewBee用のIPAを生成します。インストールするには%@に共有してください。続けますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TreeNewBee 2 다운로드가 완료되면, %@(으)로 설치해주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "TreeNewBee wygeneruje plik ipa dla innego TreeNewBee. Proszę udostępnić go do %@ aby go zainstalować. Czy chcesz kontynuować?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O contêiner atual irá gerar o arquivo IPA para outro contêiner. Por favor, compartilhe-o para %@ para concluir a instalação. Deseja continuar?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "TreeNewBee создаст файл IPA для другого TreeNewBee'а. Поделитесь им с %@, чтобы завершить установку. Хотите продолжить?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "TreeNewBee kommer att generera ipa för en annan TreeNewBee. Vänligen dela den till %@ för att installera den, Fortsätt?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TreeNewBee, başka bir TreeNewBee için ipa dosyası oluşturacaktır. Yüklemek için lütfen %@ ile paylaşın, devam etmek ister misiniz?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "TreeNewBee sẽ tạo file ipa cho TreeNewBee khác. Hãy chia sẻ nó qua %@ để cài nó. Tiếp tục?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "🌲树应用将会生成另一个🌲树应用的IPA，请将其分享至%@以安装。要继续吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "🌲树应用會產生IPA來安裝另一個🌲树应用。如要安裝請分享至%@。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "TreeNewBee will สร้าง ipa f หรือ TreeNewBee อื่น Please แชร์ไปที่ %@ เพื่อ install ดำเนินการต่อหรือไม่"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "TreeNewBee will menjana ipa f atau TreeNewBee yang lain. Please kongsikannya kepada %@ untuk install itu, Teruskan?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "TreeNewBee will menghasilkan ipa fatau TreeNewBee lainnya. Please bagikan ke %@ untuk install, Lanjutkan?"
          }
        }
      }
    },
