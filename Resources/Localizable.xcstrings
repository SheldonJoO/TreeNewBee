    "lc.appSettings.classicModeDesc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "(Experimental) Guides the system to display the app at the appropriate resolution. On iPad OS, the app will be displayed in iPhone mode if it does not natively support iPad."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "(Experimental) Guides ระบบเป็น display แอปที่ resolution ที่เหมาะสม บนระบบปฏิบัติการ iPad แอป will จะเป็น displayed ใน iPhone mode if โดยที่ does ไม่ใช่ Natively รองรับ iPad"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "(Eksperimenl) GuiXTOK1Menyatakan sistem kepada displai apl pada resolution yang sesuai. Pada OS iPad, apl will menjadi displayed dalam iPhone mode if ia does bukan aslily menyokong iPad."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "(Eksperimenl) Guides sistem ke display aplikasi di resolution yang sesuai. Pada OS iPad, aplikasi will menjadi displayed di iPhone mode if dan does bukan aslily mendukung iPad."
          }
        }
      }
    },
