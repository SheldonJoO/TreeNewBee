          "stringUnit": {
            "state": "translated",
            "value": "인증서를 찾을 수 없습니다. 내장 openSSS에 로그인 상태를 확인해주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Certyfikat nie został znaleziony. Czy zalogowałeś się do wbudowanego openSSS?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Certificado não encontrado. Você fez 'login' na openSSS integrada?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сертификат не найден. Вы вошли в аккаунт во встроенном openSSS?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sertifika bulunamadı. Yerleşik openSSS'a giriş yaptınız mı?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tìm thấy chứng chỉ. Bạn đã đăng nhập vào openSSS tích hợp chưa?"
          }
        },
        "zh-Hans": {
