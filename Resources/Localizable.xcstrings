    "lc.jitlessSetup.error.testLibLoadFailed %@ %@ %@": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل تحميل مكتبة الاختبار. هذا يعني أن الشهادة الخاصة بك قد تواجه مشكلة. يرجى محاولة: 1. إعادة فتح %@؛ 2. تحديث جميع التطبيقات في %@؛ 3. إعادة تصحيح %@ وحاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Testbibliothek konnte nicht geladen werden. Dies bedeutet, dass Ihr Zertifikat möglicherweise ein Problem aufweist. Bitte versuchen Sie es: 1. Öffnen Sie %@ erneut; 2. aktualisieren Sie alle Anwendungen in %@; 3. patchen Sie %@ erneut und versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The test library has failed to load. This means your certificate may be having issue. Please try to: 1. Reopen %@; 2. Refresh all apps in %@; 3. Re-patch %@ and try again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La bibliothèque de test n'a pas pu être chargée. Cela signifie que votre certificat peut avoir un problème. Veuillez essayer de : 1. Rouvrir %@ ; 2. Rafraîchir toutes les applications dans %@ ; 3. Re-patcher %@ et réessayer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テストライブラリの読み込みが失敗しました。証明書にエラが発生する可能性があります。以下を試してください：1.%@を再開します、2.%@のすべてのアプリをリフレッシュします%、3.まだエラ発生があるとしたら、%@をリパッチしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A biblioteca de teste falhou ao carregar. Isso significa que o seu certificado pode estar tendo problemas. Por favor, tente os seguintes passos: 1. Reabra %@; 2. Atualize todos os aplicativos em %@; 3. Recorrija %@ e tente novamente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Testbiblioteket har misslyckats med att ladda. Detta innebär att ditt certifikat kan ha problem. Försök att: 1. Öppna %@; 2. Uppdatera alla appar i %@; 3. Re-patch %@ och försök igen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể tải được thư viện test. Có nghĩa là chứng chỉ có vấn đề. Hãy thử: 1. Mở lại %@; 2. Làm mới các app trong %@; 3. Vá lại %@ và thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加载测试动态链接库，这可能是由于证书出现问题。请尝试：1. 重新打开%@；2. 刷新%@；3. 如果仍有问题，请尝试重新给%@打补丁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法載入測試動態連結庫，這可能是由於證書出現問題。請嘗試：1. 重新打開%@；2. 刷新%@；3. 如果仍有問題，請嘗試重新修補%@。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Certilicate ล่าสุด Upfate Date %@ %@ %@"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Certilicate Tarikh Kemas Kini Terakhirfate %@ %@ %@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Certilicate Terakhir Diperbaruifate Tanggal %@ %@ %@"
          }
        }
      }
    },
