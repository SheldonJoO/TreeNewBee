    "lc.settings.jitLessDesc": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمنحك دون-JIT أن تستعمل TreeNewBee دون الحاجة لتفعيل JIT."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit JIT-less können Sie TreeNewBee verwenden, ohne JIT aktivieren zu müssen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JIT-less allows you to use TreeNewBee without having to enable JIT."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "JIT-Less te permite usar TreeNewBee sin necesidad de activar JIT."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode sans JIT vous permet d'utiliser TreeNewBee sans avoir à activer le JIT."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "JIT-less ti permette di usare TreeNewBee senza dover abilitare JIT."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "JITレスは、JITを有効化せずにTreeNewBeeを使用することができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TreeNewBee를 사용하려면 JIT가 필요합니다. JIT 없이 사용하려면 JIT-Less을 활성화하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryb JIT-Less pozwala Ci używać TreeNewBee bez włączenia JIT."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modo JIT-Less permite que TreeNewBee seja usado sem a necessidade do JIT. "
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Режим JIT-less позволяет вам использовать TreeNewBee без разрешения JIT."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
