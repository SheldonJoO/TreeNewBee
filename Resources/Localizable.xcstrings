    "lc.settings.injectLCItselfDesc": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضع تعديلاتك على مِلَفّ التعديلات العالمي و TreeNewBee سوف يأخذهم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legen Sie Ihre Tweaks in den globalen Tweak-Ordner und TreeNewBee wird sie aufnehmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place your tweaks into the global “Tweaks” folder and TreeNewBee will pick them up."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez vos tweaks dans le dossier global \"Tweaks\" et TreeNewBee les récupérera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効にすると、TreeNewBee は自動的にグローバルモジュールフォルダー内のモジュールをロードします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque seus ajustes na pasta global com nome de \"Ajustes\" e o TreeNewBee irá identificá-los."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
