    "lc.settings.silentOpenWebPageDesc": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بالأساس، TreeNewBee يسألك كيف تفتح رابط. تفعيل هذا الخِيار سوف يفتح TreeNewBee الروابط تِلْقائيًا في التطبيق الحالي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig fragt TreeNewBee, wie eine URL geöffnet werden soll. Aktivieren Sie diese Option, um URLs automatisch in der aktuellen App zu öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By default, TreeNewBee asks you how to open a URL. Enable this to automatically open URL in current app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por defecto, TreeNewBee te pregunta cómo abrir una URL. Activa esto para abrir la URL automáticamente en la app actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par défaut, TreeNewBee vous demande comment ouvrir une URL. Activez cette option pour ouvrir automatiquement l'URL dans l'application en cours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Di default, TreeNewBee ti chiede come vuoi aprire un URL. Abilita ciò per aprire automaticamente l'URL nell'app corrente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトでは、TreeNewBeeはURLを開く方法を尋ねます。オンにすると、自動的に現在のアプリでURLを開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 선택 없이 URL을 바로 열고 싶은 경우 활성화해주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Domyślnie, TreeNewBee pyta się Ciebie, w jaki sposób otworzyć łącze URL. Włącz tę opcję, aby automatycznie otwierać URL w aktualnie używanej aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por padrão, TreeNewBee perguntará como você deseja abrir uma URL. Habilite esta configuração para automaticamente abrir uma URL no aplicativo atual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию LiveContauner будет у вас спрашивать, как открыть данный URL. Включите это, чтобы автоматически открывать URL в текущем приложении."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Som standard frågar TreeNewBee dig hur du öppnar en URL. Aktivera detta för att automatiskt öppna URL i aktuell app."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsayılan olarak, TreeNewBee bir URL'yi nasıl açacağınızı sorar. Bunu etkinleştirerek URL'yi mevcut uygulamada otomatik olarak açabilirsiniz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mặc định, TreeNewBee sẽ hỏi bạn cách mở URL. Bật tùy chọn này để tự động mở URL trong ứng dụng hiện tại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "🌲树应用在打开链接时会询问你如何打开。启用此选项来自动在当前App中打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "🌲树应用 默認詢問如何打開連結。開啟後會自動在當前app開啟連結。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โดย default TreeNewBee จะถามคุณถึงวิธีการเปิด URL Enable สิ่งนี้เพื่อเปิด URL อัตโนมัติlly ในแอปปัจจุบัน"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Oleh default, TreeNewBee bertanya kepada anda cara membuka URL. Enable ini kepada automatikally membuka URL dalam apl semasa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Oleh default, TreeNewBee menanyakan cara membuka URL. Aktifkan le ini untuk membuka URL otomatis lly di aplikasi saat ini."
          }
        }
      }
    },
