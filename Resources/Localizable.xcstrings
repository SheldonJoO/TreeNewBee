            "state": "translated",
            "value": "Adakah anda pasti mahu menyahpasangll %@?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apakah Anda yakin ingin menghapus instalasill %@?"
          }
        }
      }
