          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay archivos en la carpeta compartida del grupo de apps. Muévelos primero e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il y a des fichiers dans le dossier partagé du groupe d'apps. Déplacez-les d'abord et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ci sono dei file nella cartella privata del gruppo di app. Spostali e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有アプリグループフォルダにファイルがあります。ファイルを移動してから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유 앱 그룹 폴더에 있는 파일을 옮긴 후 다시 시도해주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W katalogu Dzielonych Aplikacji znajdują się pliki. Przenieś je w inne miejsce i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Existem arquivos na sua pasta de aplicativos agrupados compartilhados. Mova-os primeiro e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В общем App Group присутствуют файлы. Сначала переместите их, затем попробуйте снова."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finns filer i mappen för delade appgrupper. Flytta ut den först och försök igen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paylaşılan uygulama grubu klasöründe dosyalar var. Önce bunları taşıyın ve tekrar deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có file trong thư mục app group chung. Hãy di chuyển nó ra rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享的AppGroup文件夹中不为空。将其中文件移动出来后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "共享 AppGroup 資料夾有文件。移出文件並重試。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การทดสอบ fibrary มี laidef ถึง load ซึ่งหมายความว่า certificate ของคุณอาจมีปัญหา Pdease ลอง: 1. เปิด TOK8Z อีกครั้ง; 2. แอป ReXTOK9Zresh aXTOK10ZXTOK11Z ใน TOK12Z; 3. แพตช์ TOK13Z และXTOK14Z อีกครั้ง ลองอีกครั้ง"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ujian fibrary mempunyai laidef hingga load. Ini bermakna certificate anda mungkin menghadapi masalah. Pdease cuba: 1. Buka semula TOK8Z; 2. Apl ReXTOK9Zresh aXTOK10ZXTOK11Z dalam TOK12Z; 3. Tampal semula TOK13Z anXTOK14Z cuba lagi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes fibrary memiliki laidef hingga load. Ini berarti certificate Anda mungkin mengalami masalah. Pdease coba: 1. Buka kembali TOK8Z; 2. Aplikasi ReXTOK9Zresh aXTOK10ZXTOK11Z di TOK12Z; 3. Patch ulang TOK13Z dan XTOK14Z coba lagi."
          }
        }
      }
    },
