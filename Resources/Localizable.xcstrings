    "lc.settings.notDevCert": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "TreeNewBee غير موقع بشهادة مطورين لذاTreeNewBee لا يعمل على الإطلاق. الرجاء توقيع TreeNewBee بشهادة التطويير"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TreeNewBee ist nicht mit einem Entwicklungszertifikat signiert, daher wird TreeNewBee nicht funktionieren. Bitte signiert Sie TreeNewBee mit einem Entwicklungszertifikat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TreeNewBee is not signed with a development certificate so TreeNewBee won't work at all. Please sign TreeNewBee with a development certificate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "TreeNewBee no está firmado con un certificado de desarrollo, por lo que no funcionará en absoluto. Firma TreeNewBee con un certificado de desarrollo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "TreeNewBee n'est pas signé avec un certificat de développement, donc TreeNewBee ne fonctionnera pas du tout. Veuillez signer TreeNewBee avec un certificat de développement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "TreeNewBee non è firmato con un certificato development quindi TreeNewBee non funzionerà. Firma TreeNewBee con un certificato development."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TreeNewBeeは開発用の証明書で署名されていないため、動作しません。有効な開発用証明書で署名してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TreeNewBee를 사용할 수 없습니다. 개발용 인증서로 설치해주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "TreeNewBee nie jest podpisany certyfikatem deweloperskim, więc w ogóle nie będzie działać. Proszę podpisać certyfikatem deweloperskim."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O TreeNewBee não está assinado com um certificado de desenvolvimento, então o TreeNewBee não irá funcionar. Por favor, assine o TreeNewBee com um certificado de desenvolvimento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "TreeNewBee не был подписан с сертификатом разработчика; TreeNewBee не сможет работать. Пожалуйста, переподпишите его с действительным сертификатом."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TreeNewBee, geliştirme sertifikası ile imzalanmadığından çalışmayacaktır. Lütfen TreeNewBee'ı geliştirme sertifikası ile imzalayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "TreeNewBee không được ký với chứng chỉ phát triển nên TreeNewBee không thể hoạt động. Vui lòng ký lại TreeNewBee với chứng chỉ phát triển."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "🌲树应用未被使用开发证书签名，因此无法正常工作。请使用开发证书签名🌲树应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "🌲树应用未使用開發證書簽名，因此無法正常運作。請使用開發證書簽名🌲树应用。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "TreeNewBee ไม่ได้ลงนาม ed ด้วยใบรับรอง developmentficate ดังนั้น TreeNewBee จะไม่ทำงานที่ all Please ลงชื่อ TreeNewBee ด้วยใบรับรอง developmentficate"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "TreeNewBee bukan signed dengan development certificate jadi TreeNewBee tidak akan berfungsi di all. Please menandatangani TreeNewBee dengan development certificate."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "TreeNewBee tidak menandatangani ed dengan sertifikat development ficate sehingga TreeNewBee tidak akan berfungsi di all. Please menandatangani TreeNewBee dengan sertifikat development ficate."
          }
        }
      }
    },
