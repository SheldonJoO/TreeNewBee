    "lc.appSettings.toPrivateAppDesc": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بنقل هذا البرنامَج إلى ملفات مستندات خاصة سوف يمنحك هذا صلاحية أضافه التعديلات والتحكم بملفات البرنامَج في برنامَج الملفات، لكن لا يمكن تشغيله من تطبيقات TreeNewBee  الاخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie diese App in den privaten Dokumentenordner verschieben, können Sie in der Dateien-App auf ihre Daten und Tweaks zugreifen, aber sie kann nicht von anderen TreeNewBeen ausgeführt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moving this app to Private Document Folder allows you to access its data and tweaks in the Files app, but it can not be run by other TreeNewBee."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover esta app a la carpeta de documentos privada te permite acceder a sus datos y tweaks en la app Archivos, pero no podrá ser ejecutada por otros TreeNewBee."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En déplaçant cette application vers le dossier de documents privés, vous pouvez accéder à ses données et à ses tweaks dans l'application Fichiers, mais elle ne peut pas être lancée par d'autres TreeNewBee."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spostando l'app nella Cartella Documenti Privati ti permette di accedere ai suoi dati e tweak nell'Applicazione File, ma non può essere eseguito da altri TreeNewBee."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリをプライベートドキュメントフォルダに移動すると、ファイルアプリでそのデータや調整にアクセスできますが、他のTreeNewBeeでは実行できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비공개 앱으로 전환 시, 파일 앱에서 데이터 및 트윅 접근이 다시 가능해집니다. 다만, 다른 TreeNewBee에서 실행은 불가능해집니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przenoszenie tej aplikacji do Prywatnego Katalogu Dokumentów pozwala na dostęp do danych oraz modyfikacji w aplikacji \"Pliki\", za to tracisz możliwość uruchomienia aplikacji używających innego TreeNewBee."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover a Pasta de Documentos Privada deste aplicativo permite você acessar os arquivos e modificações no aplicativo 'Arquivos', mas não se poderá mais abrir este aplicativo em outros contêineres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перемещение данного приложения в папку личных документов даст доступ к его данным и твикам в приложении \"Файлы\", но вы потеряете возможность запустить это приложение в других TreeNewBee."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Genom att flytta denna app till privat dokumentmapp kan du komma åt dess data och tweaks i appen Filer, men det kan inte köras av andra TreeNewBee."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu uygulamayı Özel Belge Klasörüne taşıyarak, Dosyalar uygulamasında uygulamanın verilerine ve ayarlarına erişebilirsiniz, ancak diğer TreeNewBee'lar tarafından çalıştırılamaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Di chuyển app này sang Thư mục Riêng tư cho phép bạn truy cập dữ liệu và tweak trong app Tệp, nhưng nó không thể được mở bởi các TreeNewBee khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将App此转换为私有App允许您在文件App中访问其数据和模块，但它不能由其他🌲树应用运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將此應用程式移動到私人文件資料夾允許您在檔案應用程式中訪問其資料和補訂，但其他🌲树应用無法執行它。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การย้ายแอปนี้ไปที่เอกสารส่วนตัว Folder allows ให้คุณเข้าถึงการปรับแต่ง data และ d ในแอป Files แต่ TreeNewBee อื่นไม่สามารถเรียกใช้ได้"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengalihkan apl ini ke Dokumen Peribadi Folder alXTOK3Membolehkan anda mengakses tweak data and dalam apl Files, tetapi ia tidak boleh dijalankan oleh TreeNewBee yang lain."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memindahkan aplikasi ini ke Dokumen Pribadi Folder all memungkinkan Anda mengakses tweak data dan d di aplikasi Files, tetapi tidak dapat dijalankan oleh TreeNewBee lainnya."
          }
        }
      }
    },
