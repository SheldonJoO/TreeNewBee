    "lc.settings.multiLC.teamIdMismatch": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "TreeNewBee 2 مُوقع بشهادة أخرى عن TreeNewBee, لذلك لن يعمل. الرجاء تثبيت TreeNewBee 2 بِنفس الحساب الذي استخدمته لتثبيت TreeNewBee"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TreeNewBee 2 ist mit einem anderen Zertifikat signiert als TreeNewBee, daher wird es nicht funktionieren. Bitte installieren Sie TreeNewBee 2 mit demselben Account, den Sie für die Installation von TreeNewBee verwendet haben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TreeNewBee 2 is signed with a different certificate from TreeNewBee, so it will not work. Please install TreeNewBee 2 with the same account you used to install TreeNewBee."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "TreeNewBee 2 está firmado con un certificado distinto al de TreeNewBee, por lo que no funcionará. Instala TreeNewBee 2 con la misma cuenta que usaste para instalar TreeNewBee."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "TreeNewBee 2 est signé avec un certificat différent de TreeNewBee, donc il ne fonctionnera pas. Veuillez installer TreeNewBee 2 avec le même compte que celui utilisé pour installer TreeNewBee."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "TreeNewBee 2 è firmato con un certificato diverso da TreeNewBee, quindi non funzionerà. Si prega di installare TreeNewBee 2 con lo stesso account usato per installare TreeNewBee."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TreeNewBee 2はTreeNewBeeと異なる証明書で署名されているため、動作しません。TreeNewBeeをインストールしたのと同じアカウントでTreeNewBee 2をインストールしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증서가 일치하지 않습니다. TreeNewBee 설치할 때 사용한 동일한 계정으로 TreeNewBee 2를 설치해주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "TreeNewBee 2 jest podpisany innym certyfikatem niż TreeNewBee, więc nie będzie działać. Proszę, zainstalować TreeNewBee 2 używając tego samego konta, którego użyto przy instalacji TreeNewBee."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O contêiner secundário está assinado com um certificado diferente do contêiner primário, então não funcionará. Por favor, instale o contêiner secundário com o mesmo certificado usado para assinar o contêiner primário."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Второй TreeNewBee подписан сертификатом, отличным от использованного с основным TreeNewBee; он не будет работать. Переустановите второй TreeNewBee с тем же аккаунтом, который вы использовали для подписи первого."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "TreeNewBee 2 är signerad med ett annat certifikat än TreeNewBee, så det fungerar inte. Installera TreeNewBee 2 med samma konto du använde för att installera TreeNewBee."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TreeNewBee 2, TreeNewBee'dan farklı bir sertifika ile imzalanmıştır, bu nedenle çalışmayacaktır. Lütfen TreeNewBee 2'yi TreeNewBee'ı yüklemek için kullandığınız aynı hesapla yükleyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "TreeNewBee 2 đã được cài với chứng chỉ khác so với TreeNewBee, nên sẽ không dùng được. Vui lòng cài TreeNewBee 2 với cùng tài khoản bạn đã dùng để cài TreeNewBee."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "签名🌲树应用 2和🌲树应用所使用的证书不一致，🌲树应用 2无法正常工作。请使用签名🌲树应用的账户安装🌲树应用 2。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "🌲树应用 2使用與🌲树应用不同的證書簽名，因此它將無法工作。 請使用您用於安裝🌲树应用的同一帳戶安裝🌲树应用 2。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "TreeNewBee 2 ลงชื่อ d พร้อมด้วย different certificate from TreeNewBee ดังนั้นจึง will ไม่ทำงาน Please install TreeNewBee 2 ด้วยบัญชีเดียวกันกับที่คุณใช้ d เพื่อ install TreeNewBee"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "TreeNewBee 2 ialah signed dengan different certificate from TreeNewBee, jadi will tidak berfungsi. Please install TreeNewBee 2 dengan akaun yang sama yang anda gunakand untuk install TreeNewBee."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "TreeNewBee 2 ditandatanganied dengan different certificate from TreeNewBee, jadi will tidak berfungsi. Please install TreeNewBee 2 dengan akun yang sama yang Anda gunakand ke install TreeNewBee."
          }
        }
      }
    },
    "lc.settings.multiLCDesc": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بتثبيت عده TreeNewBee، وتحويل عده تطبيقات الى تطبيقات مُشارَكه، يمكنك فتح تطبيق واحد بين جميع TreeNewBee مع جميع ملفاتها وبياناتها وأعداداتها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durch die Installation mehrerer TreeNewBee und die Konvertierung von Apps in geteilte Apps können Sie eine App in allen TreeNewBeen mit den meisten ihrer Daten und Einstellungen öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By installing multiple TreeNewBee, and converting apps to Shared Apps, you can open one app between all TreeNewBee with most of its data and settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalando múltiples TreeNewBee y convirtiendo las apps en Apps Compartidas, puedes abrir una app entre todos los TreeNewBee conservando la mayoría de sus datos y ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En installant plusieurs TreeNewBee et en convertissant les applications en apps partagées, vous pouvez ouvrir une application entre tous les TreeNewBee avec la plupart de ses données et paramètres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installando più TreeNewBee e convertendo app in applicazioni condivise, è possibile aprire un'app tra tutti i TreeNewBee con la maggior parte dei suoi dati e impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数のTreeNewBeeをインストールし、アプリを共有アプリに変換することで、ほとんどのデータや設定を保持したまま、すべてのTreeNewBee間で1つのアプリを開くことができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TreeNewBee를 여러 개 설치할 경우, 앱 여러 개를 동시에 실행할 수 있습니다. (설치한 앱은 공유된 앱으로 변환해야 합니다.)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalując wiele TreeNewBee’ów i zmieniając aplikacje w Aplikacje Współdzielonych, możesz otworzyć jedną aplikację między wszystkimi TreeNewBee’ami, nie tracąc żadnych ustawień czy danych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao instalar múltiplos contêineres, e converter os aplicativos em Aplicativos Compartilhados, você consegue abrir um aplicativo entre todos os contêineres com a maioria de seus dados e configurações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установив несколько TreeNewBee'ов, вы сможете открывать приложения, преобразованные в общие, на всех TreeNewBee'ах с сохранением большинства данных и настроек."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Genom att installera flera TreeNewBee och konvertera appar till delade appar kan du öppna en app mellan alla TreeNewBee med de flesta av dess data och inställningar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birden fazla TreeNewBee kurup uygulamaları Paylaşılan Uygulamalar’a dönüştürerek; paylaştığınız uygulamaları tüm TreeNewBee’larda, uygulama ayarları ve verileriyle birlikte kullanabilirsiniz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bằng cách cài đặt nhiều TreeNewBee và chuyển đổi app thành App được Chia sẻ, bạn có thể mở app giữa tất cả các TreeNewBee với hầu hết dữ liệu và cài đặt của app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过安装多个🌲树应用，并将App变为共享App，你可以在这些🌲树应用间共享安装的App及其数据，并同时运行多个App。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過安裝多個🌲树应用，並將App變成共享App，你可以在這些🌲树应用間共享安裝的App和其數據，並同時執行多個App。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โดย installing multiple TreeNewBee ซึ่งเป็น and ที่แปลงแอปเป็น Shared Apps คุณสามารถเปิดแอปเดียวระหว่าง all TreeNewBee กับ of ส่วนใหญ่ของการตั้งค่า data และ d"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
