    "lc.appSettings.useLCBundleIdDesc": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أصحّح هذه الأخطاء باستخدام معرف الحزمه الخاص ب TreeNewBee ويضعه فوق معرف الحزمة الخاص بالتطبيق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behebt diese Probleme durch die Verwendung der Bundle-Kennung von TreeNewBee beim Überschreiben des Haupt-Bundles."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixes these issues by using TreeNewBee’ bundle identifier when overwriting main bundle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrige estos problemas usando el identificador de paquete de TreeNewBee al sobrescribir el paquete principal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrige ces problèmes en utilisant l'identifiant du bundle de TreeNewBee lors de l'écrasement du bundle principal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistema questi problemi usando il Bundle ID di TreeNewBee quando sovrascrivi il bundle principale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メインバンドルを上書きするときにTreeNewBeeのバンドル識別子を使用することでこれらの問題を修正します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메인 번들을 TreeNewBee 번들 식별자로 덮어씌워서 문제를 해결합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naprawia te problemy przy użyciu identyfikatora pakietu TreeNewBee podczas nadpisywania głównego pakietu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta opção corrige estes erros usando o identificador do pacote do TreeNewBee para substituir o pacote principal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исправляет некоторые проблемы использованием ИД пакета TreeNewBee'а в ходе перезаписи основного пакета."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixar dessa problem genom att använda TreeNewBee bunt identifierare när du skriver över huvudbuntet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana paketi üzerine yazarken TreeNewBee paket tanımlayıcısını kullanarak bu sorunları giderir"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sửa các lỗi này bằng cách dùng định danh TreeNewBee khi ghi đè gói chính."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过使用🌲树应用的包名解决上述问题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在覆蓋主捆綁包時，透過使用🌲树应用的捆綁包識別符號來修復這些問題。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แก้ไขปัญหาเหล่านี้โดยใช้ bundle identifier ของ TreeNewBee เมื่อเขียนทับ main bundle"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Selesaikan isu ini dengan menggunakan bundle identifier TreeNewBee apabila menulis ganti bundle utama."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memperbaiki masalah ini dengan menggunakan bundle identifier TreeNewBee saat menimpa bundle utama."
          }
        }
      }
    },
